public class CountVowels {
    public static void main(String[] args) {
        String str = "Programming";
        int count = 0;

        str = str.toLowerCase();

        for (char c : str.toCharArray()) {
            if ("aeiou".indexOf(c) != -1)
                count++;
        }

        System.out.println("Vowels = " + count);
    }
}
