public class PositiveNegative {
    public static void main(String[] args) {
        int[] arr = {-2,5,-7,9,10,-4};

        int positive = 0, negative = 0;

        for(int n : arr){
            if(n >= 0)
                positive++;
            else
                negative++;
        }

        System.out.println("Positive = " + positive);
        System.out.println("Negative = " + negative);
    }
}
